\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {System scaling and counterfactual clock replay calibration.} \textbf  {(a)} Across dataset sizes $N \in [250, 25000]$ rows, \texttt  {Bundle.check()} scales sub-linearly as $\mathcal  {O}(N^{0.2637})$, completing in $111.17\text  { ms}$ P50 with $3.66\text  { MB}$ peak memory at $N=25{,}000$ rows. \textbf  {(b)} Static future-year holdout (\texttt  {2023}) fails to punish same-session post-close joins ($\text  {Sharpe} = 22.80$), whereas physical session-by-session clock replay (\texttt  {live\_replay.py}) exposes the true live loss ($\text  {Sharpe} = -0.58$).}}{7}{figure.caption.17}\protected@file@percent }
\newlabel{fig:scaling_replay}{{2}{7}{\textbf {System scaling and counterfactual clock replay calibration.} \textbf {(a)} Across dataset sizes $N \in [250, 25000]$ rows, \texttt {Bundle.check()} scales sub-linearly as $\mathcal {O}(N^{0.2637})$, completing in $111.17\text { ms}$ P50 with $3.66\text { MB}$ peak memory at $N=25{,}000$ rows. \textbf {(b)} Static future-year holdout (\texttt {2023}) fails to punish same-session post-close joins ($\text {Sharpe} = 22.80$), whereas physical session-by-session clock replay (\texttt {live\_replay.py}) exposes the true live loss ($\text {Sharpe} = -0.58$)}{figure.caption.17}{}}
