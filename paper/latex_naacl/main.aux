\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Overview of our two core empirical discoveries.} \textbf  {(a) The Agent Compliance Paradox (\S  \ref {sec:experiment}):} Equipping a strong model (Claude Opus) with \texttt  {fin-skills} reduces Sharpe reporting error by $84\%$ ($0.19 \to 0.03$), whereas giving a weak model (Claude Haiku) passive text documentation without mandatory runtime execution induces severe reporting distortion ($|\Delta \text  {Sharpe}| = 11.95$) due to \emph  {hallucinated guard citations}. \textbf  {(b) The $3.96\times $ KOL Megaphone Bias (\S  \ref {sec:realworld}):} Across $1{,}445$ verified A-share influencers, statistically confirmed contrarian indicators ($N=98$, 5-day Rank IC $-0.2130$) command $3.96\times $ more followers ($55.99\text  {k}$) than Tier-1 Alpha researchers ($N=70$, $14.12\text  {k}$ fans, Rank IC $+0.2158$), explaining why unweighted financial NLP loses money.}}{2}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:overview}{{1}{2}{\textbf {Overview of our two core empirical discoveries.} \textbf {(a) The Agent Compliance Paradox (\S \ref {sec:experiment}):} Equipping a strong model (Claude Opus) with \texttt {fin-skills} reduces Sharpe reporting error by $84\%$ ($0.19 \to 0.03$), whereas giving a weak model (Claude Haiku) passive text documentation without mandatory runtime execution induces severe reporting distortion ($|\Delta \text {Sharpe}| = 11.95$) due to \emph {hallucinated guard citations}. \textbf {(b) The $3.96\times $ KOL Megaphone Bias (\S \ref {sec:realworld}):} Across $1{,}445$ verified A-share influencers, statistically confirmed contrarian indicators ($N=98$, 5-day Rank IC $-0.2130$) command $3.96\times $ more followers ($55.99\text {k}$) than Tier-1 Alpha researchers ($N=70$, $14.12\text {k}$ fans, Rank IC $+0.2158$), explaining why unweighted financial NLP loses money}{figure.caption.1}{}}
